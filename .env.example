# Copy to .env (never commit real values). All values below are placeholders.
# Neon (Vercel Storage integration injects these automatically). Leave unset locally to use data/admin.sqlite3.
# DATABASE_URL = pooled (PgBouncer, host contains "-pooler"); the app reads it, falling back to POSTGRES_URL.
DATABASE_URL=postgresql://USER:YOUR_DB_PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) URL: only for applying db/schema.sql with psql. The app does not read it.
DATABASE_URL_UNPOOLED=postgresql://USER:YOUR_DB_PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require
NATAL_ADMIN_PASSWORD=change-me-long-random-password
NATAL_ADMIN_SECRET=change-me-32-plus-random-characters
NATAL_ALLOWED_HOSTS=your-app.vercel.app,www.example.com
